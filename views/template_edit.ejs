<%- include('layout/header') %>
<div class="drawer lg:drawer-open">
    <input id="my-drawer" type="checkbox" class="drawer-toggle" />
    
    <!-- Main Content -->
    <div class="drawer-content flex flex-col">
        <!-- Toggle button for mobile -->
        <div class="flex justify-between items-center p-4 bg-base-200">
            <div class="lg:hidden">
                <label for="my-drawer" class="btn btn-square btn-ghost">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-6 h-6 stroke-current">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </label>
            </div>
            <div class="flex gap-2">
                <button id="saveButton" class="btn btn-primary">Save Template</button>
                <button id="autoSaveToggle" class="btn">Auto-save: Off</button>
            </div>
        </div>
        
        <!-- Split View Container -->
        <div class="flex flex-1 h-[calc(100vh-4rem)] overflow-hidden">
            <!-- Code Editor Section -->
            <div class="w-1/2 h-full">
                <div class="h-full">
                    <textarea id="codeEditor" class="h-full"><%= template.content %></textarea>
                </div>
            </div>
            
            <!-- PDF Preview Section -->
            <div class="w-1/2 h-full p-4">
                <div class="card bg-base-100 shadow-xl h-full">
                    <div class="card-body">
                        <h2 class="card-title">PDF Preview</h2>
                        <div class="flex-1 bg-base-200 rounded-lg overflow-hidden">
                            <iframe id="pdfPreview" class="w-full h-full"></iframe>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <%- include('layout/navbars/sidebar1') %>
    </div>
</div>

<script>
    const templateId = '<%= template._id %>';
</script>
<script src="/dist/bundle.js"></script>
<%- include('layout/footer') %>